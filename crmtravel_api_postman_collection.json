    {
      "name": "3. Lead Management & Webhooks",
      "item": [
        {
          "name": "List Leads (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads?page=1&per_page=15&search=John&status=new",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "search",
                  "value": "John"
                },
                {
                  "key": "status",
                  "value": "new"
                }
              ]
            }
          }
        },
        {
          "name": "Create New Lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul.sharma@example.com\",\n  \"phone\": \"9876543210\",\n  \"source_id\": 1,\n  \"destination\": \"Himachal Pradesh\",\n  \"travel_date\": \"2026-09-15\",\n  \"pax_adults\": 2,\n  \"pax_children\": 1,\n  \"budget\": 55000.0,\n  \"status\": \"new\",\n  \"assigned_to\": 1,\n  \"notes\": \"Prefers luxury hotel with mountain view\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads"
              ]
            }
          }
        },
        {
          "name": "Assign Lead to Sales Executive",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assigned_to\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leads/1/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "1",
                "assign"
              ]
            }
          }
        },
        {
          "name": "Meta Lead Webhook Ingestion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Meta Lead User\",\n  \"phone\": \"9123456789\",\n  \"email\": \"meta.lead@example.com\",\n  \"destination\": \"Kerala\",\n  \"campaign_source\": \"Meta Facebook Ads\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/leads/meta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "leads",
                "meta"
              ]
            }
          }
        },
        {
          "name": "Website Form Webhook Ingestion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website Form Lead\",\n  \"phone\": \"9876543211\",\n  \"email\": \"web.lead@example.com\",\n  \"destination\": \"Manali\",\n  \"campaign_source\": \"Website Popup\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/leads/website",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "leads",
                "website"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Bookings Management & Handoff",
      "item": [
        {
          "name": "List Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings?status=confirmed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "confirmed"
                }
              ]
            }
          }
        },
        {
          "name": "Assign Operations Staff to Booking",
          "request": {
            "method": "PUT",

            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operations_id\": 8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/1/assign-operations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
